
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Marks Management System</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: Arial, sans-serif;
}

body {
    background: #f1f5f9;
    color: #1e293b;
}

header {
    background: #172554;
    color: white;
    padding: 22px;
    text-align: center;
}

nav {
    background: #1e40af;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 12px;
}

nav button {
    background: transparent;
    color: white;
    border: none;
    padding: 12px 20px;
    cursor: pointer;
    font-size: 16px;
    border-radius: 5px;
}

nav button:hover,
nav button.active {
    background: #2563eb;
}

.container {
    max-width: 1150px;
    margin: 25px auto;
    padding: 15px;
}

.page {
    display: none;
}

.page.active {
    display: block;
}

h2 {
    margin-bottom: 20px;
    color: #172554;
}

.form-card,
.result-card,
.table-card {
    background: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 25px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.08);
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.input-group {
    display: flex;
    flex-direction: column;
}

label {
    font-weight: bold;
    margin-bottom: 7px;
}

input {
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    font-size: 15px;
}

input:focus {
    outline: 2px solid #93c5fd;
    border-color: #2563eb;
}

.error {
    color: #dc2626;
    font-size: 13px;
    margin-top: 5px;
    min-height: 16px;
}

.get-result {
    width: 100%;
    margin-top: 22px;
    padding: 14px;
    border: none;
    border-radius: 6px;
    background: #16a34a;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

.get-result:hover {
    background: #15803d;
}

.dashboard {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    margin-bottom: 25px;
}

.dashboard-card {
    padding: 22px;
    color: white;
    border-radius: 10px;
    text-align: center;
}

.total { background: #2563eb; }
.passed { background: #16a34a; }
.failed { background: #dc2626; }

.dashboard-card h3 {
    font-size: 17px;
    margin-bottom: 10px;
}

.dashboard-card p {
    font-size: 28px;
    font-weight: bold;
}

table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
}

th, td {
    padding: 11px;
    border: 1px solid #e2e8f0;
    text-align: center;
    font-size: 14px;
}

th {
    background: #1e40af;
    color: white;
}

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.action-btn {
    padding: 7px 10px;
    border: none;
    color: white;
    border-radius: 4px;
    margin: 3px;
    cursor: pointer;
}

.view-btn { background: #2563eb; }
.delete-btn { background: #dc2626; }
.pdf-btn { background: #16a34a; }

.pass-text {
    color: #15803d;
    font-weight: bold;
}

.fail-text {
    color: #dc2626;
    font-weight: bold;
}

.grade {
    font-weight: bold;
    color: #1d4ed8;
}

.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin-bottom: 20px;
}

.detail-item {
    background: #f1f5f9;
    padding: 12px;
    border-radius: 5px;
}

.percentage-card {
    background: #eff6ff;
    padding: 18px;
    border-radius: 8px;
    margin-top: 15px;
}

.empty {
    text-align: center;
    padding: 20px;
    color: #64748b;
}

@media(max-width: 650px) {
    .form-grid,
    .dashboard,
    .detail-grid {
        grid-template-columns: 1fr;
    }

    header h1 {
        font-size: 21px;
    }
}
</style>
</head>

<body>

<header>
    <h1>Student Marks Management System</h1>
    <p>Student Details, Marks and Grade Management</p>
</header>

<nav>
    <button class="active" onclick="showPage('home', this)">Home</button>
    <button onclick="showPage('result', this)">Results</button>
    <button onclick="showPage('percentage', this)">Percentage</button>
</nav>

<div class="container">

<!-- HOME PAGE -->
<section id="home" class="page active">

    <h2>Student Registration</h2>

    <div class="dashboard">

        <div class="dashboard-card total">
            <h3>Total Students</h3>
            <p id="totalCount">0</p>
        </div>

        <div class="dashboard-card passed">
            <h3>Passed Students</h3>
            <p id="passCount">0</p>
        </div>

        <div class="dashboard-card failed">
            <h3>Failed Students</h3>
            <p id="failCount">0</p>
        </div>

    </div>

    <div class="form-card">

        <form id="studentForm" novalidate>

            <div class="form-grid">

                <div class="input-group">
                    <label>Student Name</label>
                    <input type="text" id="studentName"
                    placeholder="Enter student name"
                    autocomplete="off">
                    <span class="error" id="nameError"></span>
                </div>

                <div class="input-group">
                    <label>Roll Number</label>
                    <input type="text" id="rollNumber"
                    placeholder="Example: 23AI101"
                    autocomplete="off">
                    <span class="error" id="rollError"></span>
                </div>

                <div class="input-group">
                    <label>Department</label>
                    <input type="text" id="department"
                    placeholder="Example: AI & ML"
                    autocomplete="off">
                    <span class="error" id="departmentError"></span>
                </div>

                <div class="input-group">
                    <label>Mathematics Marks</label>
                    <input type="number" id="math" placeholder="0 - 100">
                    <span class="error" id="mathError"></span>
                </div>

                <div class="input-group">
                    <label>Physics Marks</label>
                    <input type="number" id="physics" placeholder="0 - 100">
                    <span class="error" id="physicsError"></span>
                </div>

                <div class="input-group">
                    <label>Chemistry Marks</label>
                    <input type="number" id="chemistry" placeholder="0 - 100">
                    <span class="error" id="chemistryError"></span>
                </div>

                <div class="input-group">
                    <label>Computer Science Marks</label>
                    <input type="number" id="computer" placeholder="0 - 100">
                    <span class="error" id="computerError"></span>
                </div>

                <div class="input-group">
                    <label>English Marks</label>
                    <input type="number" id="english" placeholder="0 - 100">
                    <span class="error" id="englishError"></span>
                </div>

            </div>

            <button type="submit" class="get-result">
                GET RESULT
            </button>

        </form>

    </div>
</section>


<!-- RESULT PAGE -->
<section id="result" class="page">

    <h2>Student Results</h2>

    <div id="singleResult" class="result-card">
        <p class="empty">Submit valid student details to view the result.</p>
    </div>

    <div class="table-card">
        <h2>All Student Records</h2>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Roll Number</th>
                        <th>Department</th>
                        <th>Maths</th>
                        <th>Physics</th>
                        <th>Chemistry</th>
                        <th>Computer</th>
                        <th>English</th>
                        <th>Total</th>
                        <th>Grade</th>
                        <th>Result</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="resultTable">
                    <tr>
                        <td colspan="12">No student records available.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</section>


<!-- PERCENTAGE PAGE -->
<section id="percentage" class="page">

    <h2>Student Percentage Details</h2>

    <div class="table-card">
        <div class="table-wrapper">

            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Roll Number</th>
                        <th>Maths %</th>
                        <th>Physics %</th>
                        <th>Chemistry %</th>
                        <th>Computer %</th>
                        <th>English %</th>
                        <th>Overall %</th>
                    </tr>
                </thead>

                <tbody id="percentageTable">
                    <tr>
                        <td colspan="8">No percentage details available.</td>
                    </tr>
                </tbody>

            </table>

        </div>
    </div>

</section>

</div>


<script>

let students = [];
let currentStudentIndex = -1;

const subjectNames = [
    "Mathematics",
    "Physics",
    "Chemistry",
    "Computer Science",
    "English"
];

const markIds = [
    "math",
    "physics",
    "chemistry",
    "computer",
    "english"
];


// PAGE NAVIGATION
function showPage(pageId, button) {

    document.querySelectorAll(".page").forEach(page => {
        page.classList.remove("active");
    });

    document.getElementById(pageId).classList.add("active");

    document.querySelectorAll("nav button").forEach(btn => {
        btn.classList.remove("active");
    });

    if (button) {
        button.classList.add("active");
    }

    if (pageId === "result") {
        displayResults();
    }

    if (pageId === "percentage") {
        displayPercentages();
    }
}


// NAME VALIDATION
function isValidName(name) {

    name = name.trim();

    // Only English letters, with single spaces between words.
    // Each name part must contain at least two letters.
    const namePattern = /^[A-Za-z]{2,}(?: [A-Za-z]{2,})*$/;

    const invalidNames = [
        "test",
        "testing",
        "unknown",
        "none",
        "null",
        "student",
        "name",
        "admin",
        "abc",
        "asdf",
        "qwerty"
    ];

    if (!namePattern.test(name)) {
        return false;
    }

    if (invalidNames.includes(name.toLowerCase())) {
        return false;
    }

    return true;
}


// ROLL NUMBER VALIDATION
function isValidRoll(roll) {
    return /^(?=.*[A-Za-z])(?=.*\d)[A-Za-z0-9]+$/.test(roll);
}


// DEPARTMENT VALIDATION
function isValidDepartment(department) {
    return /^[A-Za-z]+(?:[ &-][A-Za-z]+)*$/.test(department.trim());
}


// GRADE CALCULATION
function getGrade(mark) {

    if (mark >= 90) return "A+";
    if (mark >= 80) return "A";
    if (mark >= 70) return "B+";
    if (mark >= 60) return "B";
    if (mark >= 50) return "C";
    if (mark >= 35) return "D";

    return "F";
}


// CLEAR ERRORS
function clearErrors() {

    document.querySelectorAll(".error").forEach(error => {
        error.textContent = "";
    });
}


// SHOW FIELD ERROR
function showError(id, message) {
    document.getElementById(id).textContent = message;
}


// FORM SUBMISSION
document.getElementById("studentForm").addEventListener("submit", function(event) {

    event.preventDefault();

    clearErrors();

    let valid = true;

    const name = document.getElementById("studentName").value.trim();
    const roll = document.getElementById("rollNumber").value.trim();
    const department = document.getElementById("department").value.trim();

    // NAME CHECK
    if (!name) {
        showError("nameError", "Student name is required.");
        valid = false;
    } else if (!isValidName(name)) {
        showError("nameError", "Enter a valid name using English letters only. Each name part must have at least 2 letters.");
        valid = false;
    }

    // ROLL CHECK
    if (!roll) {
        showError("rollError", "Roll number is required.");
        valid = false;
    } else if (!isValidRoll(roll)) {
        showError("rollError", "Roll number must contain letters and numbers only.");
        valid = false;
    } else if (students.some(student =>
        student.roll.toLowerCase() === roll.toLowerCase()
    )) {
        showError("rollError", "This roll number already exists. Duplicate students are not allowed.");
        valid = false;
    }

    // DEPARTMENT CHECK
    if (!department) {
        showError("departmentError", "Department is required.");
        valid = false;
    } else if (!isValidDepartment(department)) {
        showError("departmentError", "Enter a valid department name.");
        valid = false;
    }

    // MARKS CHECK
    let marks = [];

    markIds.forEach((id, index) => {

        const value = document.getElementById(id).value;

        if (value === "") {
            showError(id + "Error", "Marks are required.");
            valid = false;
            return;
        }

        const mark = Number(value);

        if (!Number.isInteger(mark) || mark < 0 || mark > 100) {
            showError(id + "Error", "Enter a whole number between 0 and 100.");
            valid = false;
            return;
        }

        marks.push(mark);
    });

    // STOP IF ANY FIELD IS INVALID
    if (!valid) {
        alert("Invalid student details! Please correct the errors. Result cannot be generated.");
        return;
    }

    // CHECK DUPLICATE COMPLETE DETAILS
    const duplicateDetails = students.some(student => {

        return (
            student.name.toLowerCase() === name.toLowerCase() &&
            student.roll.toLowerCase() === roll.toLowerCase() &&
            student.department.toLowerCase() === department.toLowerCase() &&
            student.marks.every((mark, index) => mark === marks[index])
        );

    });

    if (duplicateDetails) {
        alert("These student details already exist. Duplicate result cannot be generated.");
        return;
    }

    // CALCULATE RESULT
    const total = marks.reduce((sum, mark) => sum + mark, 0);

    const pass = marks.every(mark => mark >= 35);

    const average = total / 5;

    const overallGrade = pass ? getGrade(average) : "F";

    const percentage = pass ? (total / 500) * 100 : null;

    const student = {
        name,
        roll,
        department,
        marks,
        total,
        pass,
        overallGrade,
        percentage
    };

    // SAVE ONLY AFTER ALL VALIDATIONS PASS
    students.push(student);

    currentStudentIndex = students.length - 1;

    // CLEAR FORM
    document.getElementById("studentForm").reset();

    clearErrors();

    // UPDATE ALL SECTIONS
    updateDashboard();
    displayResults();
    displayPercentages();
    displaySingleResult(currentStudentIndex);

    // AUTOMATICALLY OPEN RESULT PAGE
    showPage("result", document.querySelectorAll("nav button")[1]);

    alert("Student result generated successfully!");

});


// INDIVIDUAL RESULT
function displaySingleResult(index) {

    const student = students[index];

    if (!student) return;

    let html = `
        <h2>Individual Student Result</h2>

        <div class="detail-grid">
            <div class="detail-item"><b>Student Name:</b> ${escapeHTML(student.name)}</div>
            <div class="detail-item"><b>Roll Number:</b> ${escapeHTML(student.roll)}</div>
            <div class="detail-item"><b>Department:</b> ${escapeHTML(student.department)}</div>
            <div class="detail-item"><b>Total Marks:</b> ${student.total}/500</div>
        </div>

        <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Marks</th>
                    <th>Grade</th>
                </tr>
            </thead>
            <tbody>
    `;

    student.marks.forEach((mark, index) => {

        html += `
            <tr>
                <td>${subjectNames[index]}</td>
                <td>${mark}</td>
                <td class="grade">${getGrade(mark)}</td>
            </tr>
        `;

    });

    html += `
            </tbody>
        </table>
        </div>

        <div class="percentage-card">
            <h3>Overall Grade: ${student.overallGrade}</h3>

            <p style="margin-top:10px">
                Result:
                <span class="${student.pass ? "pass-text" : "fail-text"}">
                    ${student.pass ? "PASS" : "FAIL"}
                </span>
            </p>

            <p style="margin-top:10px">
                Overall Percentage:
                <b>${student.pass ? student.percentage.toFixed(2) + "%" : "Not Calculated"}</b>
            </p>

            <button class="action-btn pdf-btn"
            onclick="downloadPDF(${index})">
                Download PDF
            </button>
        </div>
    `;

    document.getElementById("singleResult").innerHTML = html;

}


// DISPLAY ALL RESULTS
function displayResults() {

    const table = document.getElementById("resultTable");

    if (students.length === 0) {
        table.innerHTML = `
            <tr><td colspan="12">No student records available.</td></tr>
        `;
        return;
    }

    table.innerHTML = "";

    students.forEach((student, index) => {

        let row = `
            <tr>
                <td>${escapeHTML(student.name)}</td>
                <td>${escapeHTML(student.roll)}</td>
                <td>${escapeHTML(student.department)}</td>
        `;

        student.marks.forEach(mark => {
            row += `<td>${mark} (${getGrade(mark)})</td>`;
        });

        row += `
            <td>${student.total}</td>
            <td>${student.overallGrade}</td>
            <td class="${student.pass ? "pass-text" : "fail-text"}">
                ${student.pass ? "PASS" : "FAIL"}
            </td>

            <td>
                <button class="action-btn view-btn"
                onclick="viewStudent(${index})">View</button>

                <button class="action-btn pdf-btn"
                onclick="downloadPDF(${index})">PDF</button>

                <button class="action-btn delete-btn"
                onclick="deleteStudent(${index})">Delete</button>
            </td>
        </tr>
        `;

        table.innerHTML += row;

    });

}


// VIEW STUDENT
function viewStudent(index) {
    currentStudentIndex = index;
    displaySingleResult(index);
    showPage("result", document.querySelectorAll("nav button")[1]);
}


// PERCENTAGE DETAILS
function displayPercentages() {

    const table = document.getElementById("percentageTable");

    if (students.length === 0) {
        table.innerHTML = `
            <tr><td colspan="8">No percentage details available.</td></tr>
        `;
        return;
    }

    table.innerHTML = "";

    students.forEach(student => {

        let row = `
            <tr>
                <td>${escapeHTML(student.name)}</td>
                <td>${escapeHTML(student.roll)}</td>
        `;

        if (student.pass) {

            student.marks.forEach(mark => {
                row += `<td>${mark.toFixed(2)}%</td>`;
            });

            row += `<td><b>${student.percentage.toFixed(2)}%</b></td>`;

        } else {

            for (let i = 0; i < 6; i++) {
                row += `<td>Not Calculated</td>`;
            }

        }

        row += "</tr>";

        table.innerHTML += row;

    });

}


// DASHBOARD
function updateDashboard() {

    const total = students.length;

    const passed = students.filter(student => student.pass).length;

    const failed = students.filter(student => !student.pass).length;

    document.getElementById("totalCount").textContent = total;

    document.getElementById("passCount").textContent = passed;

    document.getElementById("failCount").textContent = failed;

}


// DELETE STUDENT
function deleteStudent(index) {

    if (!confirm("Are you sure you want to delete this student record?")) {
        return;
    }

    students.splice(index, 1);

    currentStudentIndex = -1;

    updateDashboard();
    displayResults();
    displayPercentages();

    document.getElementById("singleResult").innerHTML = `
        <p class="empty">Select a student using the View button to see the result.</p>
    `;

    alert("Student record deleted successfully.");

}


// SAFE DISPLAY OF TEXT
function escapeHTML(value) {

    return String(value).replace(/[&<>"']/g, character => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
    })[character]);

}


// DOWNLOAD PDF
function downloadPDF(index) {

    const student = students[index];

    if (!student) return;

    if (!window.jspdf) {
        alert("PDF library could not be loaded. Check your internet connection.");
        return;
    }

    const { jsPDF } = window.jspdf;

    const pdf = new jsPDF();

    pdf.setFontSize(18);
    pdf.text("STUDENT MARKS REPORT", 60, 20);

    pdf.setFontSize(12);

    pdf.text("Student Name: " + student.name, 20, 40);
    pdf.text("Roll Number: " + student.roll, 20, 50);
    pdf.text("Department: " + student.department, 20, 60);

    pdf.text("SUBJECT DETAILS", 20, 80);

    let y = 95;

    pdf.text("Subject", 20, y);
    pdf.text("Marks", 100, y);
    pdf.text("Grade", 150, y);

    y += 10;

    student.marks.forEach((mark, index) => {

        pdf.text(subjectNames[index], 20, y);
        pdf.text(String(mark), 100, y);
        pdf.text(getGrade(mark), 150, y);

        y += 10;

    });

    y += 10;

    pdf.text("Total Marks: " + student.total + "/500", 20, y);

    y += 10;

    pdf.text("Overall Grade: " + student.overallGrade, 20, y);

    y += 10;

    pdf.text("Result: " + (student.pass ? "PASS" : "FAIL"), 20, y);

    y += 10;

    pdf.text(
        "Overall Percentage: " +
        (student.pass ? student.percentage.toFixed(2) + "%" : "Not Calculated"),
        20,
        y
    );

    pdf.save(student.roll + "_Result.pdf");

}


// INITIAL DISPLAY
updateDashboard();
displayResults();
displayPercentages();

</script>

</body>
</html>
